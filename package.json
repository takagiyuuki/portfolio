{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "yukit-dev",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "biome check --write .",
    "renovate:validate": "npm_config_ignore_scripts=true pnpm dlx --package renovate renovate-config-validator --strict",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && actionlint"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "astro-icon": "^1.2.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@iconify-json/simple-icons": "^1.2.98",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.8",
    "lefthook": "^1.13.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.143.0"
  },
  "packageManager": "pnpm@11.1.2"
}
