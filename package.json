{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "yukit-dev",
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "biome check --write .",
    "renovate:validate": "pnpm dlx --package renovate renovate-config-validator --strict",
    "precheck": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && actionlint"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.6",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@iconify-json/lucide": "^1.2.109",
    "@iconify-json/simple-icons": "^1.2.83",
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.9.1",
    "lefthook": "^1.11.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.6",
    "wrangler": "^4.95.0"
  },
  "packageManager": "pnpm@11.1.2"
}
