---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '@/config/site';

interface Props {
  title: string;
  heading?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = `${title} - ${site.name}`;

const navItems = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/timeline/', label: 'Timeline' },
] as const;

const currentPath = Astro.url.pathname;
const isCurrent = (href: string): boolean => currentPath === href;
const isHome = currentPath === '/';

// The home page has no page-level heading; every other page defaults to its title.
const heading = Astro.props.heading ?? (isHome ? undefined : title);
// Exactly one h1 per page: the brand takes the role when there is no page heading.
const Brand = heading === undefined ? 'h1' : 'p';

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-noto-jp" preload />
  </head>
  <body>
    <div class="layout">
      <header class="sidebar">
        <Brand class="brand">
          <a href="/" class="home" aria-current={isHome ? "page" : undefined}>
            <Icon name="lucide:bird" aria-hidden="true" />
            <span>{site.author}</span>
          </a>
        </Brand>
        <nav class="nav" aria-label="Primary">
          <ul>
            {navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                <span class="marker" aria-hidden="true" />
                <span>{item.label}</span>
              </a>
            </li>
            ))}
          </ul>
        </nav>
      </header>
      <main class="main">
        {heading && <h1>{heading}</h1>}
        <slot />
      </main>
      <footer class="footer">
        <p>© {year} {site.author}</p>
        <ul>
          <li>
            <a
              href={site.social.github}
              aria-label="GitHub"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="simple-icons:github" />
            </a>
          </li>
          <li>
            <a
              href={site.social.linkedin}
              aria-label="LinkedIn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="simple-icons:linkedin" />
            </a>
          </li>
        </ul>
      </footer>
    </div>
    <style>
    /* Mobile-first: single column, sidebar collapses to a top bar */
    .layout {
      max-width: 780px;
      margin: 0 auto;
      padding: 1.5rem 1rem;
      min-height: 100vh;
      display: grid;
      grid-template-areas:
        'sidebar'
        'main'
        'footer';
      grid-template-rows: auto 1fr auto;
      gap: 2.5rem;
    }

    .sidebar {
      grid-area: sidebar;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }

    .brand {
      margin: 0;
      font-size: var(--text-brand);
      font-weight: 600;
      line-height: 1.3;
    }

    .home {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--foreground);
      text-decoration: none;
    }

    .home svg {
      width: 1.25em;
      height: 1.25em;
    }

    .nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav a {
      display: inline-flex;
      flex-direction: column-reverse;
      align-items: center;
      gap: 0.25rem;
      font-size: var(--text-nav);
      color: var(--foreground-muted);
      text-decoration: none;
    }

    .nav a:hover {
      color: var(--foreground);
    }

    .nav a[aria-current='page'] {
      color: var(--link);
    }

    .nav .marker {
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 50%;
      background-color: currentColor;
      visibility: hidden;
    }

    .nav a[aria-current='page'] .marker {
      visibility: visible;
    }

    .nav li,
    .footer li {
      margin-block-end: 0;
    }

    .main {
      grid-area: main;
      min-width: 0;
    }

    .footer {
      grid-area: footer;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: var(--text-small);
      color: var(--foreground-muted);
      margin-block-start: 2rem;
    }

    .footer p {
      margin: 0;
    }

    .footer ul {
      display: flex;
      gap: 0.75rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .footer a {
      color: var(--foreground-muted);
      display: inline-flex;
      text-decoration: none;
    }

    .footer a:hover {
      color: var(--foreground);
    }

    .footer svg {
      width: 1em;
      height: 1em;
    }

    /* Desktop: sidebar on the left, spanning main and footer rows */
    @media (min-width: 768px) {
      .layout {
        max-width: 940px;
        padding: 4rem 2rem;
        grid-template-columns: 160px 1fr;
        grid-template-areas:
          'sidebar main'
          'sidebar footer';
        grid-template-rows: 1fr auto;
        column-gap: 4.5rem;
        row-gap: 0;
      }

      .sidebar {
        gap: 2.5rem;
        position: sticky;
        top: 4rem;
        align-self: start;
      }

      .main {
        max-width: 65ch;
      }

      .footer {
        margin-block-start: 6rem;
      }

      .nav ul {
        flex-direction: column;
        gap: 0.5rem;
      }

      .nav a {
        flex-direction: row;
        gap: 0.4rem;
      }
    }
    </style>
  </body>
</html>
