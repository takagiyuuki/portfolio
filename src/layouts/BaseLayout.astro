---
import '@/styles/global.css';

import Footer from '@/components/Footer.astro';
import Meta from '@/components/Meta.astro';
import Sidebar from '@/components/Sidebar.astro';

import type { PageMeta } from '@/types/page';

interface Props extends PageMeta {
  /** Defaults to title. The brand is icon-only, so h1 lives in <main>. */
  heading?: string;
  /** Where the brand and the nav's Home entry point. /en/ is its own front door. */
  homeHref?: string;
}

// The brand is icon-only, so every page carries its h1 in <main>.
const {
  title,
  heading = title,
  description,
  lang = 'en',
  alternate,
  isFrontDoor,
  homeHref = '/',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Meta {title} {description} {lang} {alternate} {isFrontDoor} />
  </head>
  <body>
    <div class="layout">
      <Sidebar {homeHref} />
      <main class="main">
        <h1>{heading}</h1>
        <slot />
      </main>
      <Footer />
    </div>
    <style>
    /* Mobile-first: single column, sidebar collapses to a top bar */
    .layout {
      max-width: 780px;
      margin: 0 auto;
      padding: 1.5rem 1rem;
      min-height: 100vh;
      display: grid;
      grid-template-areas:
        'sidebar'
        'main'
        'footer';
      grid-template-rows: auto 1fr auto;
      gap: 2.5rem;
    }

    .main {
      grid-area: main;
      min-width: 0;
    }

    /* Desktop: sidebar on the left, spanning main and footer rows */
    @media (min-width: 768px) {
      .layout {
        max-width: 940px;
        padding: 4rem 2rem;
        grid-template-columns: 160px 1fr;
        grid-template-areas:
          'sidebar main'
          'sidebar footer';
        grid-template-rows: 1fr auto;
        column-gap: 4.5rem;
        row-gap: 0;
      }

      .main {
        max-width: 65ch;
      }
    }
    </style>
  </body>
</html>
