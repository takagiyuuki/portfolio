---
import { Icon } from 'astro-icon/components';
import { site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer>
  <ul>
    <li>
      <a href={site.social.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        <Icon name="simple-icons:github" />
      </a>
    </li>
    <li>
      <a
        href={site.social.linkedin}
        aria-label="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="simple-icons:linkedin" />
      </a>
    </li>
  </ul>
  <p>© {year} {site.author}</p>
</footer>
<style>
/* Selector is the element; the value is the grid area named by the layout.
   Grid placement is declared on the item, so it resolves across scopes. */
footer {
  grid-area: footer;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.75rem;
  font-family: var(--font-chrome);
  font-size: var(--text-footer);
  line-height: var(--leading-chrome);
  letter-spacing: var(--tracking-chrome);
  text-transform: uppercase;
  color: var(--foreground-muted);
  margin-block-start: 2rem;
}

/* Unset the base-layer rhythm from global.css. */
p {
  margin: 0;
}

ul {
  display: flex;
  gap: 0.75rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

li {
  margin-block-end: 0;
}

a {
  color: var(--social-icon);
  display: inline-flex;
  text-decoration: none;
}

a:hover {
  color: var(--foreground);
}

svg {
  /* 24px makes each icon a 24 x 24 target on its own (WCAG 2.5.8). */
  width: var(--size-icon);
  height: var(--size-icon);
}

@media (min-width: 768px) {
  footer {
    margin-block-start: 6rem;
  }
}
</style>
