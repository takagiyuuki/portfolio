---
import { Icon } from 'astro-icon/components';
import { site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer>
  <p>© {year} {site.author}</p>
  <ul>
    <li>
      <a href={site.social.github} aria-label="GitHub" target="_blank" rel="noopener noreferrer">
        <Icon name="simple-icons:github" />
      </a>
    </li>
    <li>
      <a
        href={site.social.linkedin}
        aria-label="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="simple-icons:linkedin" />
      </a>
    </li>
  </ul>
</footer>
<style>
/* Selector is the element; the value is the grid area named by the layout.
   Grid placement is declared on the item, so it resolves across scopes. */
footer {
  grid-area: footer;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: var(--text-small);
  color: var(--foreground-muted);
  margin-block-start: 2rem;
}

/* Unset the base-layer rhythm from global.css. */
p {
  margin: 0;
}

ul {
  display: flex;
  gap: 0.75rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

li {
  margin-block-end: 0;
}

a {
  color: var(--foreground-muted);
  display: inline-flex;
  text-decoration: none;
}

a:hover {
  color: var(--foreground);
}

svg {
  width: 1em;
  height: 1em;
}

@media (min-width: 768px) {
  footer {
    margin-block-start: 6rem;
  }
}
</style>
