---
import { site } from '@/config/site';

interface Props {
  /** Where the brand and the Home entry point. /en/ is its own front door. */
  homeHref?: string;
}

const { homeHref = '/' } = Astro.props;

const navItems = [
  { href: homeHref, label: 'Home' },
  { href: '/work/', label: 'Work' },
  { href: '/timeline/', label: 'Timeline' },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string): boolean => currentPath === href;
---

<header>
  <p class="brand">
    <a href={homeHref} class="home">
      <img src="/logo.svg" alt={site.author} width="45" height="45" />
    </a>
  </p>
  <nav class="nav" aria-label="Primary">
    <ul>
      {navItems.map((item) => (
  <li>
    <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
      <span class="marker" aria-hidden="true" />
      <span>{item.label}</span>
    </a>
  </li>
))}
    </ul>
  </nav>
</header>

<style>
header {
  grid-area: sidebar;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2rem;
  view-transition-name: sidebar;

  /* One font context for the whole chrome surface, so the brand's hidden '>'
    spacer below resolves to exactly the width of the nav marker. */
  font-family: var(--font-chrome);
  font-size: var(--text-nav);
  line-height: var(--leading-chrome);
  letter-spacing: var(--tracking-chrome);
  text-transform: uppercase;

  --logo-size: 2.7rem;
  --marker-size: 0.4rem;
  --marker-gap: 0.4rem;
}

.brand {
  margin: 0;
  display: flex;
}

.home {
  display: block;
}

.home img {
  display: block;
  width: var(--logo-size);
  height: var(--logo-size);
  transition: opacity 150ms;
}

.home:hover img,
.home:focus-visible img {
  opacity: 0.7;
}

.nav ul {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

li {
  margin-block-end: 0;
}

nav a {
  display: inline-flex;
  flex-direction: column-reverse;
  align-items: center;
  gap: 0.25rem;
  color: var(--color-text-muted);
  text-decoration: none;
}

nav a:hover {
  color: var(--color-text);
}

nav a[aria-current='page'] {
  color: var(--color-accent);
}

.marker {
  width: var(--marker-size);
  height: var(--marker-size);
  border-radius: 50%;
  background-color: currentColor;
  visibility: hidden;
}

nav a[aria-current='page'] .marker {
  visibility: visible;
}

@media (min-width: 768px) {
  header {
    /* The first nav label lands on the first paragraph's line in <main>: the h1
   line box plus its bottom margin, less the logo that sits above the nav.
    max() keeps the gap sane if a future mark is taller than the h1 block. */
    gap: max(
      1rem,
      calc(var(--text-h1) * var(--leading-heading) + var(--space-h1) - var(--logo-size))
    );
    position: sticky;
    top: 4rem;
    align-self: start;
  }

  /* The brand lines up with the nav labels by reserving the same glyph in the
   same font, rather than by recomputing its width. */
  .brand::before {
    content: '>';
    visibility: hidden;
    margin-inline-end: var(--marker-gap);
  }

  .nav ul {
    flex-direction: column;
    gap: var(--gap-nav);
  }

  nav a {
    flex-direction: row;
    gap: var(--marker-gap);
  }

  /* A prompt only reads as one inline, and the mobile marker sits below the
   label, so the dot stays there and the glyph is desktop-only. */
  .marker {
    width: auto;
    height: auto;
    border-radius: 0;
    background-color: transparent;
  }

  .marker::before {
    content: '>';
  }
}
</style>
