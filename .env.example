# ---------------------------------------------------------------------------
# Local secrets/config for Terraform / Wrangler workflows.
# Copy this file to `.env`, fill in real values, and never commit the result.
# direnv loads `.env` automatically (see .envrc). In CI these come from
# GitHub Secrets, not from this file.
# ---------------------------------------------------------------------------

# R2 (S3-compatible) backend credentials for the Terraform tfstate.
# Despite the AWS_ prefix, these are Cloudflare R2 access keys: the S3 backend
# reads them from these standard AWS variable names.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cloudflare API token, used by:
#   - Terraform cloudflare provider (scopes: Zone:Read, DNS:Edit)
#   - Wrangler deploy
# Issuing steps: docs/ops/cf-account-bootstrap.md
CLOUDFLARE_API_TOKEN=

# Cloudflare account ID (NOT secret). Used to build the R2 backend endpoint URL
# at `terraform init`: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID=
TF_VAR_cloudflare_account_id="${CLOUDFLARE_ACCOUNT_ID}"
