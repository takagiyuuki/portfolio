{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-05-29",
  "workers_dev": false, // disable default production url
  "preview_urls": false, // disable default preview url
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
